   "permissions": [ "alarms", "notifications", "storage", "tts" ],
   "update_url": "https://clients2.google.com/service/update2/crx",
   "version": "0.02",
   "web_accessible_resources": [ {
      "matches": [ "https://*.torn.com/*" ],
