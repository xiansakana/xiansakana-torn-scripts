# Torn API 配置（多个API Key用逗号分隔）
TORN_API_KEYS=YOUR_API_KEY_1,YOUR_API_KEY_2,YOUR_API_KEY_3
# API Key 对应的公司名称（顺序要和上面一致）
TORN_API_NAMES=公司名称1,公司名称2,公司名称3
CHECK_INTERVAL=60

# 邮件通知配置
EMAIL_ENABLED=true
EMAIL_SERVICE=qq
EMAIL_USER=your-email@qq.com
EMAIL_PASS=your-auth-code
EMAIL_TO=recipient@163.com
EMAIL_FROM=your-email@qq.com

# Webhook 通知配置（可选）
WEBHOOK_ENABLED=false
WEBHOOK_URL=
