# Torn API 配置
TORN_API_KEY=your_api_key_here
CHECK_INTERVAL=60

# 邮件通知配置
EMAIL_ENABLED=true
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_TO=recipient@example.com
EMAIL_FROM=your-email@gmail.com

# Webhook 通知配置（可选）
WEBHOOK_ENABLED=false
WEBHOOK_URL=https://discord.com/api/webhooks/...

# Qmsg酱 QQ群通知配置（可选）
QMSG_ENABLED=false
QMSG_KEY=your_qmsg_key_here
QMSG_QQ=your_qq_group_number

# 过滤器配置（可选）
FILTER_MIN_DIFFICULTY=simple
FILTER_MIN_SCOPE=1
FILTER_PLAYERS=
